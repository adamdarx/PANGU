# SYNC-1 coupled Z4c+GRHD initialization smoke test.  The flat ADM geometry is
# constructed first and the fluid is then converted to Valencia conserved
# variables before its stress-energy enters the Z4c constraints.

<parthenon/job>
problem_id = sync_grhd_shock

<pangu>
strict_parameters = true
compatibility_mode = native

<geometry>
background = minkowski
expected_metric = z4c
expected_mode = sync

<parthenon/mesh>
refinement = none
numlevel = 1
nghost = 2
nx1 = 32
x1min = -0.5
x1max = 0.5
ix1_bc = periodic
ox1_bc = periodic
nx2 = 4
x2min = -0.5
x2max = 0.5
ix2_bc = periodic
ox2_bc = periodic
nx3 = 4
x3min = -0.5
x3max = 0.5
ix3_bc = periodic
ox3_bc = periodic

<parthenon/meshblock>
nx1 = 16
nx2 = 4
nx3 = 4

<parthenon/time>
integrator = rk2
tlim = 0.0
nlim = 0
ncycle_out_mesh = 1

<numerical_relativity>
cfl = 0.3
finite_difference_order = 2
matter_source = grhd

<hydro>
physics = gr
eos = ideal
gamma = 1.6666666666666667
gamma_max = 1000.0
reconstruct = plm
rsolver = hlle
cfl = 0.3
density_floor = 1.0e-12
pressure_floor = 1.0e-12
fofc = false

<problem>
write_final_csv = false
x0 = 0.0
density_left = 10.0
pressure_left = 13.33
velocity_left = 0.0
density_right = 1.0
pressure_right = 1.0e-6
velocity_right = 0.0

<parthenon/output1>
file_type = hdf5
dt = 1.0
variables = hydro.prim,hydro.cons,nr.z4c,nr.adm,nr.tmunu,nr.constraints
id = sync_grhd
single_precision_output = false
ghost_zones = false
