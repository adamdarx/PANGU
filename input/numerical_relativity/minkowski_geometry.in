# NR-0 synchronized-geometry smoke problem. The physical Z4c RHS is introduced
# in NR-2; this case verifies stage storage, boundaries, and ADM reconstruction.

<parthenon/job>
problem_id = nr_minkowski

<pangu>
strict_parameters = true
compatibility_mode = native

<geometry>
background = minkowski
expected_metric = z4c
expected_mode = sync

<parthenon/mesh>
refinement = none
numlevel = 1
nghost = 2
nx1 = 16
x1min = -0.5
x1max = 0.5
ix1_bc = periodic
ox1_bc = periodic
nx2 = 16
x2min = -0.5
x2max = 0.5
ix2_bc = periodic
ox2_bc = periodic
nx3 = 16
x3min = -0.5
x3max = 0.5
ix3_bc = periodic
ox3_bc = periodic

<parthenon/meshblock>
nx1 = 8
nx2 = 8
nx3 = 8

<parthenon/time>
integrator = rk2
tlim = 0.05
nlim = 4
ncycle_out_mesh = 1

<numerical_relativity>
cfl = 0.4
finite_difference_order = 2

<parthenon/output1>
file_type = hst
dt = 0.025

<parthenon/output2>
file_type = hdf5
dt = 0.025
variables = nr.z4c,nr.adm
id = geometry
single_precision_output = false
ghost_zones = false
