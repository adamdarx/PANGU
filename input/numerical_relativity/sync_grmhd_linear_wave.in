# SYNC-2 AthenaK-matched dynamic-GRMHD eigenmode and CT gate.  The public
# AthenaK convergence problem evolves GRMHD on Minkowski ADM data without Z4c
# feedback, so this input uses the explicit zero-source reference path.

<parthenon/job>
problem_id = sync_grmhd_linear_wave

<pangu>
strict_parameters = true
compatibility_mode = native

<geometry>
background = minkowski
expected_metric = z4c
expected_mode = sync

<parthenon/mesh>
refinement = none
nghost = 3
nx1 = 64
x1min = -0.5
x1max = 0.5
ix1_bc = periodic
ox1_bc = periodic
nx2 = 4
x2min = -0.25
x2max = 0.25
ix2_bc = periodic
ox2_bc = periodic
nx3 = 4
x3min = -0.25
x3max = 0.25
ix3_bc = periodic
ox3_bc = periodic

<parthenon/meshblock>
nx1 = 32
nx2 = 4
nx3 = 4

<parthenon/time>
integrator = rk2
tlim = 1.2740874403053475
nlim = -1
ncycle_out_mesh = 1

<numerical_relativity>
cfl = 0.3
finite_difference_order = 2
matter_source = zero

<mhd>
physics = gr
eos = ideal
gamma = 1.333333
gamma_max = 1000.0
sigma_max = 1.0e12
reconstruct = plm
rsolver = hlle
cfl = 0.3
density_floor = 1.0e-10
pressure_floor = 1.0e-10
fofc = false
nscalars = 0

<problem>
wave_flag = 0
amp = 1.0e-6
dens = 4.0
pgas = 1.0
vx0 = -0.1
vy0 = 0.3
vz0 = -0.05
bx0 = 2.5
by0 = 1.8
bz0 = -1.2
along_x1 = true

<parthenon/output1>
file_type = hdf5
dt = 0.12740874403053475
variables = mhd.prim,mhd.cons,mhd.b_cell,mhd.b_face,mhd.divb,nr.z4c,nr.adm,nr.tmunu,nr.constraints
id = sync_grmhd_wave
single_precision_output = false
ghost_zones = false
