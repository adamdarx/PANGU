# AthenaK reference deck for the matched Figure 26 gauge-wave campaign.

<job>
basename = athenak_gauge

<mesh>
nghost = 2
nx1 = 64
x1min = 0.0
x1max = 1.0
ix1_bc = periodic
ox1_bc = periodic
nx2 = 4
x2min = 0.0
x2max = 1.0
ix2_bc = periodic
ox2_bc = periodic
nx3 = 4
x3min = 0.0
x3max = 1.0
ix3_bc = periodic
ox3_bc = periodic

<meshblock>
nx1 = 64
nx2 = 4
nx3 = 4

<time>
evolution = dynamic
integrator = rk2
cfl_number = 0.5
nlim = -1
tlim = 10.0
ndiag = 10

<z4c>
diss = 0.02
chi_div_floor = 1.0e-5
damp_kappa1 = 0.02
damp_kappa2 = 0.0
lapse_harmonic = 1.0
lapse_oplog = 0.0
shift_Gamma = 0.0
shift_eta = 2.0

<problem>
pgen_name = z4c_gauge_wave
amp = 0.01

<output1>
file_type = tab
variable = z4c
data_format = %.16e
dt = 10.0
slice_x2 = 0.5
slice_x3 = 0.5
ghost_zones = false

<output2>
file_type = hst
user_hist = false
data_format = %12.5e
dt = -1
