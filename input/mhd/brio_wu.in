# PANGU stage-3 Brio-Wu MHD shock tube

<parthenon/job>
problem_id = brio_wu

<pangu>
strict_parameters = true
compatibility_mode = native

<parthenon/mesh>
refinement = none
nghost = 2
nx1 = 128
x1min = -0.5
x1max = 0.5
ix1_bc = outflow
ox1_bc = outflow
nx2 = 1
x2min = -0.5
x2max = 0.5
ix2_bc = periodic
ox2_bc = periodic
nx3 = 1
x3min = -0.5
x3max = 0.5
ix3_bc = periodic
ox3_bc = periodic

<parthenon/meshblock>
nx1 = 64
nx2 = 1
nx3 = 1

<parthenon/time>
integrator = rk2
tlim = 0.1
nlim = 10000
ncycle_out_mesh = 20

<mhd>
eos = ideal
gamma = 2.0
reconstruct = plm
rsolver = hlle
cfl = 0.3
density_floor = 1.0e-12
pressure_floor = 1.0e-12
fofc = true
nscalars = 0

<problem>
x0 = 0.0
density_left = 1.0
pressure_left = 1.0
density_right = 0.125
pressure_right = 0.1
b1 = 0.75
b2_left = 1.0
b2_right = -1.0

<parthenon/output1>
file_type = hst
dt = 0.02
