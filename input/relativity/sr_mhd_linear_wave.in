# AthenaK-aligned SRMHD entropy eigenmode, evolved for one wave period.
<parthenon/job>
problem_id = sr_mhd_linear_wave
<pangu>
strict_parameters = true
compatibility_mode = native
<parthenon/mesh>
refinement = none
nghost = 2
nx1 = 128
x1min = 0.0
x1max = 1.0
ix1_bc = periodic
ox1_bc = periodic
nx2 = 1
x2min = -0.5
x2max = 0.5
ix2_bc = periodic
ox2_bc = periodic
nx3 = 1
x3min = -0.5
x3max = 0.5
ix3_bc = periodic
ox3_bc = periodic
<parthenon/meshblock>
nx1 = 64
nx2 = 1
nx3 = 1
<parthenon/time>
integrator = rk2
tlim = 2.0
nlim = 10000
ncycle_out_mesh = 100
<mhd>
physics = sr
eos = ideal
gamma = 1.3333333333333333
gamma_max = 1000.0
sigma_max = 1.0e6
reconstruct = plm
rsolver = hlle
cfl = 0.3
density_floor = 1.0e-12
pressure_floor = 1.0e-12
fofc = false
<geometry>
background = minkowski
<problem>
ambient_density = 1.0
ambient_pressure = 1.0
amplitude = 1.0e-6
vx0 = 0.5
vy0 = 0.1
vz0 = -0.05
bx0 = 1.0
by0 = 0.5
bz0 = -0.25
wave_flag = 3
<parthenon/output1>
file_type = hst
dt = 0.25
<parthenon/output2>
file_type = hdf5
dt = 0.25
variables = mhd.prim,mhd.b_cell,mhd.divb
