# PANGU stage-5 SRMHD Mignone--Ugliano--Bodo shock tube 1.
<parthenon/job>
problem_id = sr_mhd_shock
<pangu>
strict_parameters = true
compatibility_mode = native
<parthenon/mesh>
refinement = none
nghost = 2
nx1 = 400
x1min = -0.5
x1max = 0.5
ix1_bc = outflow
ox1_bc = outflow
nx2 = 1
x2min = -0.5
x2max = 0.5
ix2_bc = periodic
ox2_bc = periodic
nx3 = 1
x3min = -0.5
x3max = 0.5
ix3_bc = periodic
ox3_bc = periodic
<parthenon/meshblock>
nx1 = 100
nx2 = 1
nx3 = 1
<parthenon/time>
integrator = rk2
tlim = 0.1
nlim = 10000
<mhd>
physics = sr
eos = ideal
gamma = 2.0
gamma_max = 1000.0
sigma_max = 1.0e6
reconstruct = plm
rsolver = hlle
cfl = 0.3
density_floor = 1.0e-12
pressure_floor = 1.0e-12
fofc = false
<geometry>
background = minkowski
<problem>
x0 = 0.0
density_left = 1.0
pressure_left = 1.0
density_right = 0.125
pressure_right = 0.1
b1 = 0.5
b2_left = 1.0
b2_right = -1.0
<parthenon/output1>
file_type = hst
dt = 0.02
<parthenon/output2>
file_type = hdf5
dt = 0.02
variables = mhd.prim,mhd.b_cell,mhd.divb
