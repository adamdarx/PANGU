# PANGU fixed-Kerr unmagnetized Fishbone--Moncrief torus problem.
# Frozen common contract: root 64^3, MeshBlock 16^3, three nested SMR levels,
# PPM4/HLLE/RK2 algorithms, and tlim=2000M.
<parthenon/job>
problem_id = gr_torus

<pangu>
strict_parameters = true
compatibility_mode = native

<parthenon/mesh>
refinement = static
nghost = 4
nx1 = 64
x1min = -64.0
x1max = 64.0
ix1_bc = torus
ox1_bc = torus
nx2 = 64
x2min = -64.0
x2max = 64.0
ix2_bc = torus
ox2_bc = torus
nx3 = 64
x3min = -64.0
x3max = 64.0
ix3_bc = torus
ox3_bc = torus

<parthenon/meshblock>
nx1 = 16
nx2 = 16
nx3 = 16

<parthenon/static_refinement0>
level = 1
x1min = -32.0
x1max = 32.0
x2min = -32.0
x2max = 32.0
x3min = -32.0
x3max = 32.0

<parthenon/static_refinement1>
level = 2
x1min = -16.0
x1max = 16.0
x2min = -16.0
x2max = 16.0
x3min = -16.0
x3max = 16.0

<parthenon/static_refinement2>
level = 3
x1min = -4.0
x1max = 4.0
x2min = -4.0
x2max = 4.0
x3min = -4.0
x3max = 4.0

<parthenon/time>
integrator = rk2
tlim = 2000.0
nlim = -1
ncycle_out_mesh = 10

<hydro>
physics = gr
eos = ideal
gamma = 1.3333333333333333
gamma_max = 20.0
reconstruct = ppm4
rsolver = hlle
cfl = 0.3
density_floor = 1.0e-8
pressure_floor = 0.333e-10
fofc = true

<geometry>
background = kerr_schild
bh_spin = 0.9375
excision = true
excision_radius = 1.0
dexcise = 1.0e-8
pexcise = 0.333e-10

<problem>
fm_torus = true
prograde = true
r_edge = 6.0
r_peak = 12.0
rho_max = 1.0
rho_min = 1.0e-5
rho_pow = -1.5
pgas_min = 0.333e-7
pgas_pow = -2.5
tilt_angle = 0.0
pert_amp = 2.0e-2

<parthenon/output1>
file_type = hst
dt = 10.0
data_format = %24.16e

<parthenon/output2>
file_type = hdf5
dt = 100.0
variables = hydro.cons,hydro.prim,hydro.fofc
id = prim
write_xdmf = true
hdf5_compression_level = 5

<parthenon/output3>
file_type = rst
dt = 500.0
id = restart
write_xdmf = true
hdf5_compression_level = 5
