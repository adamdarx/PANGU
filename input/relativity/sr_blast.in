# PANGU paper campaign: two-dimensional special-relativistic blast wave.
<parthenon/job>
problem_id = sr_blast
<pangu>
strict_parameters = true
compatibility_mode = native
<parthenon/mesh>
refinement = none
nghost = 2
nx1 = 128
x1min = -6.0
x1max = 6.0
ix1_bc = periodic
ox1_bc = periodic
nx2 = 128
x2min = -6.0
x2max = 6.0
ix2_bc = periodic
ox2_bc = periodic
nx3 = 1
x3min = -0.5
x3max = 0.5
ix3_bc = periodic
ox3_bc = periodic
<parthenon/meshblock>
nx1 = 64
nx2 = 64
nx3 = 1
<parthenon/time>
integrator = rk2
tlim = 1.0
nlim = 10000
<hydro>
physics = sr
eos = ideal
gamma = 1.3333333333333333
gamma_max = 1000.0
reconstruct = plm
rsolver = hlle
cfl = 0.3
density_floor = 1.0e-12
pressure_floor = 1.0e-12
fofc = true
<geometry>
background = minkowski
<problem>
ambient_density = 1.0
ambient_pressure = 5.0e-3
inner_pressure = 1.0
radius = 0.8
x0 = 0.0
y0 = 0.0
<parthenon/output1>
file_type = hst
dt = 0.125
<parthenon/output2>
file_type = hdf5
dt = 0.125
variables = hydro.prim
