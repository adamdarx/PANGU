# AthenaK-compatible radiation-hydrodynamic damped linear wave.
# The physical final time is one amplitude-halving time:
# ln(2)/abs(problem/omega_imag) = 26.466117168206284.

<parthenon/job>
problem_id = rad_linear_wave

<pangu>
strict_parameters = true
compatibility_mode = native

<parthenon/mesh>
refinement = adaptive
numlevel = 2
nghost = 4
nx1 = 32
x1min = 0.0
x1max = 1.0
ix1_bc = periodic
ox1_bc = periodic
nx2 = 1
x2min = 0.0
x2max = 1.0
ix2_bc = periodic
ox2_bc = periodic
nx3 = 1
x3min = 0.0
x3max = 1.0
ix3_bc = periodic
ox3_bc = periodic

<parthenon/meshblock>
nx1 = 8
nx2 = 1
nx3 = 1

# AthenaK's official test refines blocks whose lab-frame density exceeds
# 1.00005.  Parthenon's native magnitude criterion expresses the same rule.
<parthenon/refinement0>
method = magnitude
field = hydro.cons
vector_i = 0
comparator = greater_than
refine_tol = 1.00005
derefine_tol = 1.00005
max_level = 2

<parthenon/time>
integrator = rk2
cfl = 0.3
tlim = 26.466117168206284
nlim = -1
ncycle_out_mesh = 100

<geometry>
background = minkowski
bh_spin = 0.0
excision = false

<hydro>
physics = gr
eos = ideal
gamma = 1.6666666666666667
reconstruct = wenoz
rsolver = hlle
cfl = 0.3
density_floor = 1.0e-12
pressure_floor = 1.0e-12
gamma_max = 1000.0
fofc = false
nscalars = 0

<radiation>
nlevel = 0
rotate_geo = false
angular_fluxes = false
reconstruct = plm
rad_source = true
fixed_fluid = false
affect_fluid = true
kappa_a = 10.0
kappa_s = 10.0
kappa_p = 0.0
arad = 19.253382731290966

<problem>
along_x1 = true
along_x2 = false
along_x3 = false
rho = 1.0
pgas = 2.497687326549491e-01
erad = 7.493061979648474e-02
delta = 1.0e-4
omega_real = 3.1488157526582414e+00
omega_imag = -2.6190006385782953e-02
drho_real = 8.3877889167048014e-01
drho_imag = 0.0
dpgas_real = 3.2084488925731219e-01
dpgas_imag = -9.9134535607493107e-03
dux_real = 4.2035369927276667e-01
dux_imag = -3.4962560317943620e-03
derad_real = 1.2904189937790903e-01
derad_imag = 1.5203926879094193e-03
dfxrad_real = 1.3260665610966586e-03
dfxrad_imag = -6.7017329068802516e-03

<parthenon/output1>
file_type = hdf5
dt = 26.466117168206284
variables = hydro.prim,radiation.intensity,radiation.moments

<parthenon/output2>
file_type = hst
dt = 1.0

<plugins>
enabled = radiation_transport
