# AthenaK-compatible advected radiation diffusion in flat spacetime.

<parthenon/job>
problem_id = rad_diffusion

<pangu>
strict_parameters = true
compatibility_mode = native

<parthenon/mesh>
refinement = none
nghost = 2
nx1 = 256
x1min = -1.0
x1max = 2.0
ix1_bc = periodic
ox1_bc = periodic
nx2 = 1
x2min = -0.5
x2max = 0.5
ix2_bc = periodic
ox2_bc = periodic
nx3 = 1
x3min = -0.5
x3max = 0.5
ix3_bc = periodic
ox3_bc = periodic

<parthenon/meshblock>
nx1 = 256
nx2 = 1
nx3 = 1

<parthenon/time>
integrator = rk2
cfl = 0.8
tlim = 5.0
nlim = -1
ncycle_out_mesh = 100

<geometry>
background = minkowski
bh_spin = 0.0
excision = false

<hydro>
physics = gr
eos = ideal
gamma = 2.0
reconstruct = plm
rsolver = hlle
cfl = 0.8
density_floor = 1.0e-12
pressure_floor = 1.0e-12
gamma_max = 1000.0
fofc = false
nscalars = 0

<radiation>
nlevel = 2
rotate_geo = true
angular_fluxes = false
reconstruct = plm
rad_source = true
fixed_fluid = true
affect_fluid = false
arad = 1.0
kappa_s = 100.0
kappa_a = 0.0
kappa_p = 0.0

<problem>
v1 = 0.1
nu = 4.0

<parthenon/output1>
file_type = hdf5
dt = 5.0
variables = hydro.prim,radiation.intensity,radiation.moments

<parthenon/output2>
file_type = hst
dt = 1.0

<plugins>
enabled = radiation_transport
