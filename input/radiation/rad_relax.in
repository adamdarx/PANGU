# AthenaK-compatible thermal radiation--gas relaxation in flat spacetime.

<parthenon/job>
problem_id = rad_relax

<pangu>
strict_parameters = true
compatibility_mode = native

<parthenon/mesh>
refinement = none
nghost = 2
nx1 = 4
x1min = 0.0
x1max = 1.0
ix1_bc = periodic
ox1_bc = periodic
nx2 = 1
x2min = 0.0
x2max = 1.0
ix2_bc = periodic
ox2_bc = periodic
nx3 = 1
x3min = -0.5
x3max = 0.5
ix3_bc = periodic
ox3_bc = periodic

<parthenon/meshblock>
nx1 = 4
nx2 = 1
nx3 = 1

<parthenon/time>
integrator = rk2
cfl = 0.3
tlim = 10.0
nlim = -1
ncycle_out_mesh = 100

<geometry>
background = minkowski
bh_spin = 0.0
excision = false

<hydro>
physics = gr
eos = ideal
gamma = 2.0
reconstruct = plm
rsolver = hlle
cfl = 0.3
density_floor = 1.0e-12
pressure_floor = 1.0e-12
gamma_max = 1000.0
fofc = false
nscalars = 0

<radiation>
nlevel = 0
rotate_geo = false
angular_fluxes = false
reconstruct = plm
rad_source = true
fixed_fluid = false
affect_fluid = true
arad = 1.0
kappa_s = 0.0
kappa_a = 1.0
kappa_p = 0.0

<problem>
erad = 1.0
temp = 100.0
v1 = 0.0

<parthenon/output1>
file_type = hdf5
dt = 1.0
variables = hydro.prim,radiation.intensity,radiation.moments

<parthenon/output2>
file_type = hst
dt = 1.0

<plugins>
enabled = radiation_transport
