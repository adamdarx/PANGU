# Matches stationary_multilevel_pangu.in primary evolution settings.
# AthenaK still computes its ordinary-step ADM constraints.
<job>
basename = stationary_gpu_bench
<mesh>
nghost = 2
nx1 = 32
x1min = -32
x1max = 32
ix1_bc = outflow
ox1_bc = outflow
nx2 = 32
x2min = -32
x2max = 32
ix2_bc = outflow
ox2_bc = outflow
nx3 = 32
x3min = -32
x3max = 32
ix3_bc = outflow
ox3_bc = outflow
<meshblock>
nx1 = 16
nx2 = 16
nx3 = 16
<time>
evolution = dynamic
integrator = rk4
cfl_number = 0.2
nlim = 40
tlim = 2
ndiag = 1
<z4c>
lapse_oplog = 2
lapse_harmonic = 0
lapse_advect = 1
shift_Gamma = 1
shift_eta = 2
shift_advect = 1
diss = 0.1
chi_div_floor = 1e-5
damp_kappa1 = 0.02
damp_kappa2 = 0
slow_start_lapse = true
ssl_damping_time = 20
ssl_damping_amp = 0.6
ssl_damping_index = 1
<mesh_refinement>
refinement = static
num_levels = 5
max_nmb_per_rank = 2048
<refined_region1>
level = 4
x1min = -4
x1max = 4
x2min = -4
x2max = 4
x3min = -4
x3max = 4
<problem>
pgen_name = z4c_boosted_puncture
punc_ADM_mass = 1
punc_velocity_x1 = 0
punc_velocity_x2 = 0
punc_velocity_x3 = 0
