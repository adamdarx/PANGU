# Field-equivalence check, not a timing benchmark: 120 blocks -> 64 blocks.
<parthenon/job>
problem_id = nr_boosted_puncture
<pangu>
compatibility_mode = native
<geometry>
background = minkowski
expected_metric = z4c
expected_mode = sync
<parthenon/mesh>
refinement = adaptive
numlevel = 2
nghost = 2
nx1 = 64
x1min = -2
x1max = 2
ix1_bc = nr_outflow
ox1_bc = nr_outflow
nx2 = 64
x2min = -2
x2max = 2
ix2_bc = nr_outflow
ox2_bc = nr_outflow
nx3 = 64
x3min = -2
x3max = 2
ix3_bc = nr_outflow
ox3_bc = nr_outflow
<parthenon/meshblock>
nx1 = 16
nx2 = 16
nx3 = 16
<parthenon/time>
integrator = rk4
tlim = 1
nlim = 20
ncycle_out = 1
<numerical_relativity>
cfl = 0.2
finite_difference_order = 2
dissipation = 0.1
chi_div_floor = 1e-5
damp_kappa1 = 0.02
damp_kappa2 = 0
slow_start_lapse = true
slow_start_amplitude = 0.6
slow_start_time = 20
slow_start_index = 1
tracker_enabled = true
tracker_refinement_radius = 0.5
tracker_0_refinement_level = 0
amr_method = tracker
weyl_enabled = false
waveform_enabled = false
horizon_enabled = false
<problem>
punc_ADM_mass = 1
punc_velocity_x1 = 0
punc_velocity_x2 = 0
punc_velocity_x3 = 0
<parthenon/static_refinement0>
level = 1
x1min = -0.5
x1max = 0.5
x2min = -0.5
x2max = 0.5
x3min = -0.5
x3max = 0.5
<parthenon/output1>
file_type = hdf5
dt = 100
id = check
variables = nr.z4c
single_precision_output = false
ghost_zones = false
