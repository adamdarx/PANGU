     // output the input parameters (input file)
     resfile.Write_any_type(sbuf.c_str(), sbuf.size(), "byte", single_file_per_rank);
@@ -633,6 +638,24 @@ void RestartOutput::WriteOutputFile(Mesh *pm, ParameterInput *pin) {
 
   // close file, clean up
   resfile.Close(single_file_per_rank);
+  // Publish only a complete checkpoint set; incomplete writes remain .partial.
+#if MPI_PARALLEL_ENABLED
+  MPI_Barrier(MPI_COMM_WORLD);
+#endif
+  if (single_file_per_rank || global_variable::my_rank == 0) {
+    if (pm->pzoom == nullptr || !pm->pzoom->write_rst) {
+      const auto blocks = single_file_per_rank ? pm->nmb_thisrank : pm->nmb_total;
+      const auto expected = step1size + step2size + step3size +
+                            sizeof(IOWrapperSizeT) + data_size*blocks;
+      if (std::filesystem::file_size(pending_name) != expected)
+        throw std::runtime_error("Incomplete restart: " + pending_name);
+    }
+    if (std::rename(pending_name.c_str(), fname.c_str()) != 0)
+      throw std::runtime_error("Restart rename failed: " + pending_name);
+  }
+#if MPI_PARALLEL_ENABLED
+  MPI_Barrier(MPI_COMM_WORLD);
+#endif
 
   return;
 }
