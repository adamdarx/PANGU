TwoPuncturesX::par_P_plus[1] = 0.0
TwoPuncturesX::par_P_minus[1] = -0.0
TwoPuncturesX::par_S_plus[2] = 0.0
TwoPuncturesX::grid_setup_method = "Taylor expansion"
TwoPuncturesX::npoints_A = 30
TwoPuncturesX::npoints_B = 30
TwoPuncturesX::npoints_phi = 16
TwoPuncturesX::Newton_tol = 1e-10
TwoPuncturesX::Newton_maxit = 10
TwoPuncturesX::TP_epsilon = 1e-12
TwoPuncturesX::TP_Tiny = 1e-12
