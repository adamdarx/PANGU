BoxInBox::position_x_1 = 0.0
BoxInBox::position_y_1 = 0
BoxInBox::position_z_1 = 0
BoxInBox::radius_1 = [-1, 200.0, 100.0, 50.0, 25.0, 12.5, 6.25, 3.125, 1.5625]
PunctureTracker::track[0] = yes
PunctureTracker::initial_x[0] = 0.0
