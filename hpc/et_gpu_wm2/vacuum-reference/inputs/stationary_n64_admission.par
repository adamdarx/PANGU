# Native compiled ET GPU comparison; physical acceptance remains pending.
ActiveThorns = "ADMBaseX BoxInBox CarpetX CoordinatesX IOUtil ODESolvers TmunuBaseX TwoPuncturesX Z4c NewRadX AEILocalInterp AHFinderDirect SphericalSurface PunctureTracker"
Cactus::cctk_show_schedule = no
Cactus::presync_mode = "mixed-error"
CarpetX::verbose = no
CarpetX::poison_undefined_values = no
CarpetX::use_subcycling = no
CarpetX::ghost_size = 3
CarpetX::max_num_levels = 9
CarpetX::regrid_every = 1000000000
