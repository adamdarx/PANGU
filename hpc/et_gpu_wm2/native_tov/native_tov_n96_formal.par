###############################
# magTOV_Z4c_AMR with 4th-order flux and vector-potential corrections.
#
# Covers the ghost exchange of the restricted fluxes and G (see
# AsterX_RestrictFluxes and AsterX_RestrictAuxTermsForAvecPsiRHS in
# src/sync.cxx), which only runs at correction order > 2: the coarse level is
# split into 8 boxes and the refined box is placed so that its edge is one
# coarse cell from a coarse box boundary, where an uncovered coarse cell reads
# a restricted flux through a ghost face. The results must not depend on the
# coarse box layout, i.e. they are the same with max_grid_size = 24.
##############################
ActiveThorns = "
    ADMBaseX
    BoxInBox
    CarpetX
    HydroBaseX
    IOUtil
    ODESolvers
    TmunuBaseX
    AsterX
    AsterSeeds
    Z4c
    AsterMasks
"

$nlevels = 8
$ncells = 96

CarpetX::verbose = no
Cactus::presync_mode = "mixed-error"
# Detailed per-routine timers (incl. AsterX_Fluxes) via TimerReport, which
# dumps every flesh timer -- unlike Cactus::cctk_timer_output, whose
# schedule-bin view hides routines driven inside the ODESolvers RHS group.
# Reports are written to the test output dir (AllTimers*.txt/.csv/.tsv,
# AllTimersReadable.txt) and captured by the CI artifact.
ActiveThorns = "TimerReport"
TimerReport::out_every                   = 50
TimerReport::out_filename                = "TimerReport"
TimerReport::output_all_timers_together  = yes
TimerReport::output_all_timers_readable  = yes
TimerReport::n_top_timers                = 50
CarpetX::poison_undefined_values = no

# Finest grid spacing is 0.15625 
# To have a symmetric grid along 0, we have odd number of points (257) 
# along each direction going from -20.078125 to +20.078125 for the finest level

CarpetX::xmin = -128
CarpetX::ymin = -128
CarpetX::zmin = -128

CarpetX::xmax = 128
CarpetX::ymax = 128
CarpetX::zmax = 128

CarpetX::ncells_x = $ncells
CarpetX::ncells_y = $ncells
CarpetX::ncells_z = $ncells

CarpetX::boundary_x =  "neumann"
CarpetX::boundary_y =  "neumann"
CarpetX::boundary_z =  "neumann"
CarpetX::boundary_upper_x =  "neumann"
CarpetX::boundary_upper_y =  "neumann"
CarpetX::boundary_upper_z =  "neumann"

CarpetX::max_num_levels = $nlevels
CarpetX::regrid_every = 128000
CarpetX::regrid_error_threshold = 0.9

CarpetX::ghost_size = 6
CarpetX::dtfac = 0.1

CarpetX::prolongation_type = "ddf" #"poly-cons3lfb"
#CarpetX::prolongation_order = 5
#CarpetX::interpolation_order = 1

CarpetX::blocking_factor_x = 1
CarpetX::blocking_factor_y = 1
CarpetX::blocking_factor_z = 1

# Coarse box boundaries at x, y, z = 0
CarpetX::max_grid_size_x = 32
CarpetX::max_grid_size_y = 32
CarpetX::max_grid_size_z = 32
# Keep the refined level in one box on any number of processes: at 4th order
# dBstag/Bvec next to the refinement boundary depend on how the refined level
# is split, which is not what this test is about
CarpetX::refine_grid_layout = no

BoxInBox::num_regions = 1
# Region 1
BoxInBox::shape_1 = "cube"
BoxInBox::num_levels_1 = $nlevels 
BoxInBox::radius_1 = [ -1,31.68,15.84,7.92,3.96,1.98,0.99,0.99 ]
# Refined box [1,7]^3: its lower edges are one coarse cell from x, y, z = 0
BoxInBox::position_x_1 = 0
BoxInBox::position_y_1 = 0
BoxInBox::position_z_1 = 0


#ADMBaseX::set_adm_variables_during_evolution = "yes"
ADMBaseX::initial_data       = "tov"
ADMBaseX::initial_lapse      = "tov"
ADMBaseX::initial_shift      = "tov"
ADMBaseX::initial_dtlapse    = "zero"
ADMBaseX::initial_dtshift    = "zero"

Z4c::calc_ADM_vars = yes                  # for Weyl
Z4c::calc_ADMRHS_vars = no  #yes               # for Weyl
Z4c::calc_constraints = yes
Z4c::chi_floor = 1.0e-6
Z4c::alphaG_floor = 1.0e-8
Z4c::epsdiss = 0
Z4c::boundary_conditions = "NewRadX"

ActiveThorns = "TOVSolverX"
TOVSolverX::TOV_Rho_Central[0] = 0.007993
TOVSolverX::TOV_Gamma          = 2.0
TOVSolverX::TOV_K              = 100.0
TOVSolverX::TOV_Cowling = no


AsterSeeds::test_type = "3DTest"
AsterSeeds::test_case = "magTOV"
AsterSeeds::Afield_config = "internal dipole"
AsterSeeds::Ab = 0.4931383477810524
AsterSeeds::press_cut = 0.00015652379680587835
AsterSeeds::press_max = 0.0063888049
AsterSeeds::Avec_kappa = 1

#AsterSeeds::Afield_config = "external dipole"
#AsterSeeds::B0 = 1e-7
#AsterSeeds::r0 = 5.0

AsterX::debug_mode = "no"
AsterX::flux_type = "HLLE"
AsterX::vector_potential_gauge = "generalized Lorenz"
AsterX::lorenz_damp_fac = 12.8571428571429
AsterX::local_spatial_order = 4
AsterX::local_estimate_error = "no"
AsterX::recon_type = "z_vec"
AsterX::use_entropy_fix = "yes"
AsterX::use_uct         = "yes"
AsterX::hydro_correction_order = 4
AsterX::mag_correction_order   = 4
AsterX::restrict_fluxes        = "yes"

ReconX::reconstruction_method = "PPM"
ReconX::ppm_zone_flattening = "yes"
ReconX::ppm_shock_detection = "no"

Con2PrimFactory::c2p_prime = "Noble"
Con2PrimFactory::c2p_second = "Palenzuela"
Con2PrimFactory::c2p_tol = 1e-8
Con2PrimFactory::max_iter = 100
Con2PrimFactory::rho_abs_min = 1e-16
Con2PrimFactory::atmo_tol = 0.02
Con2PrimFactory::unit_test = "no"
Con2PrimFactory::B_lim = 1e8
Con2PrimFactory::vw_lim = 1e8
Con2PrimFactory::Ye_lenient = "yes"
Con2PrimFactory::use_z = "yes"
Con2PrimFactory::thermal_eos_atmo = "no"

EOSX::evolution_eos = "IdealGas"
EOSX::gl_gamma = 2.0
EOSX::poly_gamma = 2.0
EOSX::poly_k = 100
EOSX::rho_max = 1e8
EOSX::eps_max = 1e8
EOSX::eps_min = 1e-16

Cactus::terminate = "time"
Cactus::cctk_final_time = 100
#Cactus::cctk_final_time = 200
ODESolvers::method = "RK2"

IO::out_dir = $parfile
IO::out_every = 2400
IO::parfile_write = no

CarpetX::out_metadata = no
CarpetX::out_norm_vars = "HydroBaseX::rho AsterX::dens HydroBaseX::Bvec AsterAnalysis::magnetic_energy AsterAnalysis::divB Z4c::HC Z4c::MtC"
CarpetX::out_norm_omit_unstable = yes

CarpetX::out_tsv_vars = "HydroBaseX::rho HydroBaseX::vel HydroBaseX::Bvec AsterX::dens ADMBaseX::alp ADMBaseX::metric Z4c::HC Z4c::MtC"

# Native physical-reference case; initial perturbation/seed differ from PANGU.
CarpetX::use_subcycling = no
TOVSolverX::TOV_Num_Radial = 400000
TOVSolverX::TOV_dr[0] = 0.001
AsterSeeds::ns_perturbation_mode = "m0"
AsterSeeds::ns_perturbation_strength = 0.01
Z4c::kappa1 = 0
Z4c::kappa2 = 0
IO::checkpoint_ID = no
IO::checkpoint_on_terminate = no
CarpetX::out_norm_every = 48

ActiveThorns = "AEILocalInterp AHFinderDirect SphericalSurface AsterAnalysis CoordinatesX"
AsterAnalysis::compute_MHD = yes
AsterAnalysis::compute_MHD_spherical = no
AHFinderDirect::N_horizons = 1
AHFinderDirect::max_allowable_horizon_radius[1] = 6
AHFinderDirect::find_every = 960
AHFinderDirect::max_Newton_iterations__initial = 50
AHFinderDirect::max_Newton_iterations__subsequent = 50
AHFinderDirect::geometry_interpolator_name = "CarpetX"
AHFinderDirect::geometry_interpolator_pars = "order=4"
AHFinderDirect::surface_interpolator_name = "Lagrange polynomial interpolation"
AHFinderDirect::surface_interpolator_pars = "order=3"
AHFinderDirect::initial_guess_method[1] = "coordinate sphere"
AHFinderDirect::initial_guess__coord_sphere__radius[1] = 2
AHFinderDirect::which_surface_to_store_info[1] = 0
AHFinderDirect::set_mask_for_individual_horizon[1] = no
AHFinderDirect::reset_horizon_after_not_finding[1] = yes
AHFinderDirect::output_BH_diagnostics = yes
AHFinderDirect::output_h_every = 0
SphericalSurface::nsurfaces = 1
SphericalSurface::maxntheta = 66
SphericalSurface::maxnphi = 124
SphericalSurface::ntheta[0] = 41
SphericalSurface::nphi[0] = 80
SphericalSurface::nghoststheta[0] = 2
SphericalSurface::nghostsphi[0] = 2
CarpetX::interpolation_order = 4
