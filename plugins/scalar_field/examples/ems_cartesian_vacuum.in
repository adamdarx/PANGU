<parthenon/job>
problem_id = scalar_field
<pangu>
strict_parameters = true
compatibility_mode = native
<plugins>
enabled = scalar_field
<geometry>
background = minkowski
expected_metric = z4c
expected_mode = sync
<parthenon/mesh>
refinement = none
nghost = 4
nx1 = 16
x1min = 0
x1max = 1
ix1_bc = periodic
ox1_bc = periodic
nx2 = 16
x2min = 0
x2max = 1
ix2_bc = periodic
ox2_bc = periodic
nx3 = 16
x3min = 0
x3max = 1
ix3_bc = periodic
ox3_bc = periodic
<parthenon/meshblock>
nx1 = 8
nx2 = 8
nx3 = 8
<parthenon/time>
integrator = rk4
tlim = 0.05
nlim = 1000
ncycle_out = 1
<numerical_relativity>
matter_source = external
rk4_variant = classical
finite_difference_order = 4
cfl = 0.25
dissipation = 0
<plugin/scalar_field>
backend = ems
coordinates = cartesian
initial_data = minkowski
amplitude = 0.000001
wave_x = 6.2831853071795864769
wave_y = 12.566370614359172954
wave_z = 18.849555921538759431
em_coupling = exponential
em_alpha = 0
cfl = 0.25
dissipation = 0
<parthenon/output1>
file_type = hdf5
dt = 0.05
variables = scalar.state,ems.gauss,nr.z4c,nr.adm,nr.tmunu,nr.constraints,nr.constraint_mask
id = scalar_ems
single_precision_output = false
ghost_zones = false
<parthenon/output2>
file_type = hst
dt = 0.01
<parthenon/output3>
file_type = rst
dt = 0.05
