# Local RN hold using the required default chi=psi^-4 representation.
# Box[-1,1] and t=0.5M are short-test settings, not long-time acceptance.
# Geometric KO=0.02 is used; the KO=0.1 no-floor control loses positivity.
<parthenon/job>
problem_id = scalar_field
<pangu>
strict_parameters = true
compatibility_mode = native
<plugins>
enabled = scalar_field
<geometry>
background = minkowski
expected_metric = z4c
expected_mode = sync
<parthenon/mesh>
refinement = none
numlevel = 1
nghost = 4
nx1 = 96
x1min = -1
x1max = 1
ix1_bc = outflow
ox1_bc = outflow
nx2 = 96
x2min = -1
x2max = 1
ix2_bc = outflow
ox2_bc = outflow
nx3 = 96
x3min = -1
x3max = 1
ix3_bc = outflow
ox3_bc = outflow
<parthenon/meshblock>
nx1 = 32
nx2 = 32
nx3 = 32
<parthenon/time>
integrator = rk4
tlim = 0.5
nlim = 1000
ncycle_out = 10
<numerical_relativity>
matter_source = external
chi_psi_power = -4
floor_chi = false
lapse_gauge = one_plus_log
shift_gauge = gamma_driver
horizon_enabled = true
horizon_start_time_0 = 0
horizon_stop_time_0 = 10
horizon_ntheta = 32
horizon_lmax = 8
horizon_iterations = 200
horizon_initial_radius = 0.21794494717703364
horizon_dt = 0.1
horizon_convergence = mass_and_expansion
horizon_expansion_tolerance = 1e-4
diagnostic_directory = diagnostics
rk4_variant = classical
finite_difference_order = 4
cfl = 0.25
dissipation = 0.02
constraint_mask_outer_radius = 0.6
<problem>
constraint_mask_radius = 0.3
<plugin/scalar_field>
backend = ems
coordinates = cartesian
initial_data = reissner_nordstrom
bh_mass = 1
bh_charge = 0.9
em_coupling = exponential
em_alpha = 5
cfl = 0.25
dissipation = 0.1
<parthenon/output1>
file_type = hdf5
dt = 0.1
variables = scalar.state,ems.gauss,nr.z4c,nr.adm,nr.tmunu,nr.constraints,nr.constraint_mask
id = scalar_ems
single_precision_output = false
ghost_zones = false
<parthenon/output2>
file_type = hst
dt = 0.05
data_format = %24.16e
<parthenon/output3>
file_type = rst
dt = 0.1
