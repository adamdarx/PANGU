# NR-4 coarse/fine physical-boundary regression for tensor-parity reflection.

<parthenon/job>
problem_id = nr_gauge_wave

<pangu>
strict_parameters = true
compatibility_mode = native

<geometry>
background = minkowski
expected_metric = z4c
expected_mode = sync

<parthenon/mesh>
refinement = adaptive
numlevel = 2
nghost = 2
nx1 = 32
x1min = -0.5
x1max = 0.5
ix1_bc = nr_reflecting
ox1_bc = nr_reflecting
nx2 = 8
x2min = -0.5
x2max = 0.5
ix2_bc = nr_reflecting
ox2_bc = nr_reflecting
nx3 = 8
x3min = -0.5
x3max = 0.5
ix3_bc = nr_reflecting
ox3_bc = nr_reflecting

<parthenon/meshblock>
nx1 = 8
nx2 = 4
nx3 = 4

<parthenon/time>
integrator = rk2
tlim = 0.003125
nlim = 1
ncycle_out_mesh = 1

<numerical_relativity>
cfl = 0.2
finite_difference_order = 2
dissipation = 0.0
refine_tolerance = 1.0e-8
derefine_tolerance = -1.0

<problem>
amplitude = 0.01

<parthenon/output1>
file_type = hdf5
dt = 0.003125
variables = nr.z4c,nr.adm
id = nr4_amr_reflecting
single_precision_output = false
ghost_zones = true
