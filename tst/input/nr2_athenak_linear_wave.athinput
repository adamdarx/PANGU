# AthenaK reference input for the NR-2 uniform-grid linear-wave comparison.
# The two slices leave x1 free, so the tabular output samples the propagation
# direction in binary64 text rather than a constant-phase transverse line.

<job>
basename = nr2_linear_wave

<mesh>
nghost = 2
nx1 = 16
x1min = 0.0
x1max = 1.0
ix1_bc = periodic
ox1_bc = periodic
nx2 = 16
x2min = 0.0
x2max = 1.0
ix2_bc = periodic
ox2_bc = periodic
nx3 = 16
x3min = 0.0
x3max = 1.0
ix3_bc = periodic
ox3_bc = periodic

<meshblock>
nx1 = 16
nx2 = 16
nx3 = 16

<time>
evolution = dynamic
integrator = rk2
cfl_number = 0.3
nlim = -1
tlim = 1.0
ndiag = 10

<z4c>
diss = 1.0

<problem>
pgen_name = z4c_linear_wave
amp = 1.0e-8
kx1 = 1.0
kx2 = 0.0
kx3 = 0.0

<output1>
file_type = tab
variable = z4c
data_format = %.17e
dcycle = 1
slice_x2 = 0.5
slice_x3 = 0.5
ghost_zones = false

<output2>
file_type = hst
dt = 0.05
