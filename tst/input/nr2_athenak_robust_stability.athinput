# AthenaK reference input for the NR-2 robust-stability statistical comparison.

<job>
basename = nr2_robust_stability

<mesh>
nghost = 2
nx1 = 4
x1min = 0.0
x1max = 1.0
ix1_bc = periodic
ox1_bc = periodic
nx2 = 4
x2min = 0.0
x2max = 1.0
ix2_bc = periodic
ox2_bc = periodic
nx3 = 50
x3min = 0.0
x3max = 1.0
ix3_bc = periodic
ox3_bc = periodic

<meshblock>
nx1 = 4
nx2 = 4
nx3 = 50

<time>
evolution = dynamic
integrator = rk4
cfl_number = 0.5
nlim = -1
tlim = 10.0
ndiag = 100

<z4c>
diss = 0.02
lapse_harmonic = 0.0
lapse_oplog = 1.0
shift_eta = 2.0
chi_div_floor = 1.0e-5
damp_kappa1 = 0.0
damp_kappa2 = 0.02

<problem>
pgen_name = z4c_stability
rho = 1.0

<output1>
file_type = hst
user_hist = true
data_format = %.17e
dt = 0.5

<output2>
file_type = tab
variable = z4c
data_format = %.17e
dt = 0.5
slice_x1 = 0.5
slice_x2 = 0.5
ghost_zones = false
