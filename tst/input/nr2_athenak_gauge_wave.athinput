# AthenaK reference input for the NR-2 gauge-wave comparison.

<job>
basename = nr2_gauge_wave

<mesh>
nghost = 2
nx1 = 32
x1min = 0.0
x1max = 1.0
ix1_bc = periodic
ox1_bc = periodic
nx2 = 4
x2min = 0.0
x2max = 1.0
ix2_bc = periodic
ox2_bc = periodic
nx3 = 4
x3min = 0.0
x3max = 1.0
ix3_bc = periodic
ox3_bc = periodic

<meshblock>
nx1 = 32
nx2 = 4
nx3 = 4

<time>
evolution = dynamic
integrator = rk4
cfl_number = 0.5
nlim = -1
tlim = 1.0
ndiag = 10

<z4c>
lapse_harmonic = 1.0
lapse_oplog = 0.0
shift_Gamma = 0.0
shift_eta = 2.0
diss = 0.02
chi_div_floor = 1.0e-5
damp_kappa1 = 0.02
damp_kappa2 = 0.0

<problem>
pgen_name = z4c_gauge_wave
amp = 0.01

<output1>
file_type = tab
variable = z4c
data_format = %.17e
dcycle = 1
slice_x2 = 0.5
slice_x3 = 0.5
ghost_zones = false

<output2>
file_type = hst
dt = 0.05
