# NR-6 end-to-end CUDA validation: a stationary unit-mass puncture with
# waveform extraction and the real-spherical-harmonic apparent-horizon fast flow.

<parthenon/job>
problem_id = nr_boosted_puncture

<pangu>
strict_parameters = true
compatibility_mode = native

<geometry>
background = minkowski
expected_metric = z4c
expected_mode = sync

<parthenon/mesh>
refinement = none
numlevel = 1
nghost = 2
nx1 = 64
x1min = -2.0
x1max = 2.0
ix1_bc = nr_outflow
ox1_bc = nr_outflow
nx2 = 64
x2min = -2.0
x2max = 2.0
ix2_bc = nr_outflow
ox2_bc = nr_outflow
nx3 = 64
x3min = -2.0
x3max = 2.0
ix3_bc = nr_outflow
ox3_bc = nr_outflow

<parthenon/meshblock>
nx1 = 64
nx2 = 64
nx3 = 64

<parthenon/time>
integrator = rk2
tlim = 0.04
nlim = 2
ncycle_out_mesh = 1

<numerical_relativity>
cfl = 0.2
finite_difference_order = 2
dissipation = 0.1
chi_div_floor = -1000.0
damp_kappa1 = 0.02
damp_kappa2 = 0.0
lapse_harmonic = 0.0
lapse_oplog = 2.0
shift_gamma = 1.0
shift_eta = 2.0
tracker_enabled = false
tracker_0_mass = 1.0
weyl_enabled = true
waveform_enabled = true
waveform_num_radii = 2
waveform_radius_1 = 1.0
waveform_radius_2 = 1.5
waveform_geodesic_level = 4
waveform_interpolation_points = 4
waveform_dt = 0.01
horizon_enabled = true
horizon_output_grid = true
horizon_start_time_0 = 0.0
horizon_stop_time_0 = 1.0e30
horizon_ntheta = 16
horizon_lmax = 4
horizon_iterations = 100
horizon_initial_radius = 0.5
horizon_flow_gain = 1.0
horizon_flow = standard
horizon_mass_tolerance = 1.0e-2
horizon_hmean_limit = 100.0
horizon_expand_guess = 1.0
diagnostic_directory = diagnostics

<problem>
punc_ADM_mass = 1.0
punc_velocity_x1 = 0.0
punc_velocity_x2 = 0.0
punc_velocity_x3 = 0.0
punc_center_x1 = 0.0
punc_center_x2 = 0.0
punc_center_x3 = 0.0
constraint_mask_radius = 0.5

<parthenon/output1>
file_type = hst
dt = 0.01

<parthenon/output2>
file_type = hdf5
dt = 0.02
variables = nr.z4c,nr.adm,nr.constraints,nr.constraint_mask,nr.weyl
id = nr6
single_precision_output = false
ghost_zones = false
