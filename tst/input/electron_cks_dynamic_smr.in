# EH-1: CKS/Dynamic GRMHD electron transport with SMR and custom boundaries.
<parthenon/job>
problem_id = gr_monopole
<pangu>
strict_parameters = true
compatibility_mode = native
<parthenon/mesh>
refinement = static
nghost = 4
nx1 = 16
x1min = -10.0
x1max = 10.0
ix1_bc = monopole
ox1_bc = monopole
nx2 = 16
x2min = -10.0
x2max = 10.0
ix2_bc = monopole
ox2_bc = monopole
nx3 = 16
x3min = -10.0
x3max = 10.0
ix3_bc = monopole
ox3_bc = monopole
<parthenon/meshblock>
nx1 = 8
nx2 = 8
nx3 = 8
<parthenon/static_refinement0>
level = 1
x1min = 1.0
x1max = 4.0
x2min = 1.0
x2max = 4.0
x3min = 1.0
x3max = 4.0
<parthenon/time>
integrator = rk2
tlim = 10.0
nlim = 2
ncycle_out_mesh = 1
<mhd>
physics = gr
eos = ideal
gamma = 1.3333333333333333
gamma_max = 10.0
sigma_max = 3.4028234663852886e38
reconstruct = plm
rsolver = hlle
cfl = 0.3
density_floor = 1.0e-6
pressure_floor = 3.33e-9
fofc = true
<electrons>
enabled = true
heating = false
gamma_e = 1.3333333333333333
gamma_p = 1.6666666666666667
init_to_fel_0 = true
fel_0 = 0.01
constant = true
howes = false
kawazura = false
werner = false
rowan = false
sharma = false
<geometry>
background = kerr_schild
expected_metric = cks
expected_mode = dynamic
bh_spin = 0.5
excision = true
excision_radius = 1.0
<problem>
sigma_norm = 5000.0
sigma_pow = -1.0
rhomin = 1.0e-6
umin = 1.0e-8
a_norm = 1.0
<parthenon/output1>
file_type = hst
dn = 1
<parthenon/output2>
file_type = hdf5
dn = 1
single_precision_output = false
ghost_zones = false
variables = mhd.cons,mhd.prim,electrons.cons,electrons.prim,mhd.fofc
<parthenon/output3>
file_type = rst
dn = 1

<plugins>
enabled = electron
