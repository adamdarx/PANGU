# NR-4 linear extrapolation boundary regression.

<parthenon/job>
problem_id = nr_gauge_wave

<pangu>
strict_parameters = true
compatibility_mode = native

<geometry>
background = minkowski
expected_metric = z4c
expected_mode = sync

<parthenon/mesh>
refinement = none
nghost = 2
nx1 = 8
x1min = 0.0
x1max = 1.0
ix1_bc = nr_extrapolate
ox1_bc = nr_extrapolate
nx2 = 8
x2min = 0.0
x2max = 1.0
ix2_bc = nr_extrapolate
ox2_bc = nr_extrapolate
nx3 = 8
x3min = 0.0
x3max = 1.0
ix3_bc = nr_extrapolate
ox3_bc = nr_extrapolate

<parthenon/meshblock>
nx1 = 8
nx2 = 8
nx3 = 8

<parthenon/time>
integrator = rk2
tlim = 0.01
nlim = 1
ncycle_out_mesh = 1

<numerical_relativity>
cfl = 0.2
finite_difference_order = 2
boundary_extrapolation_order = 1
dissipation = 0.0

<problem>
amplitude = 1.0e-3

<parthenon/output1>
file_type = hdf5
dt = 0.01
variables = nr.z4c
id = nr4_extrapolate
single_precision_output = false
ghost_zones = true
