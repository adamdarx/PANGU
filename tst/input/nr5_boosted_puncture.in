# NR-5 minimal x-boosted puncture initial-data smoke test.  The analytic
# slice follows AthenaK's z4c_boosted_puncture generator; evolution and the
# compact-object tracker are tested separately.

<parthenon/job>
problem_id = nr_boosted_puncture

<pangu>
strict_parameters = true
compatibility_mode = native

<geometry>
background = minkowski
expected_metric = z4c
expected_mode = sync

<parthenon/mesh>
refinement = none
numlevel = 1
nghost = 2
nx1 = 16
x1min = -8.0
x1max = 8.0
ix1_bc = nr_outflow
ox1_bc = nr_outflow
nx2 = 16
x2min = -8.0
x2max = 8.0
ix2_bc = nr_outflow
ox2_bc = nr_outflow
nx3 = 16
x3min = -8.0
x3max = 8.0
ix3_bc = nr_outflow
ox3_bc = nr_outflow

<parthenon/meshblock>
nx1 = 16
nx2 = 16
nx3 = 16

<parthenon/time>
integrator = rk2
tlim = 0.0
nlim = 0
ncycle_out_mesh = 1

<numerical_relativity>
tracker_enabled = true
# Set a nonnegative radius in adaptive runs to restrict chi-gradient tagging
# to a tracker-centered ball; -1 preserves the global indicator.
tracker_refinement_radius = -1.0
tracker_center_x1 = 0.0
tracker_center_x2 = 0.0
tracker_center_x3 = 0.0
cfl = 0.2
finite_difference_order = 2
dissipation = 0.1
chi_div_floor = -1000.0
damp_kappa1 = 0.02
damp_kappa2 = 0.0
lapse_harmonic = 0.0
lapse_oplog = 2.0
shift_gamma = 1.0
shift_eta = 2.0

<problem>
punc_ADM_mass = 1.0
punc_velocity_x1 = 0.5
punc_velocity_x2 = 0.0
punc_velocity_x3 = 0.0
punc_center_x1 = 0.0
punc_center_x2 = 0.0
punc_center_x3 = 0.0
constraint_mask_radius = 0.5

<parthenon/output1>
file_type = hst
dt = 1.0

<parthenon/output2>
file_type = hdf5
dt = 1.0
variables = nr.z4c,nr.adm,nr.constraints,nr.constraint_mask
id = boosted_puncture
single_precision_output = false
ghost_zones = false
