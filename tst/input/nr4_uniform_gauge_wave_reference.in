# NR-4 uniform fine-grid reference for the AMR gauge-wave crossing test.

<parthenon/job>
problem_id = nr_gauge_wave

<pangu>
strict_parameters = true
compatibility_mode = native

<geometry>
background = minkowski
expected_metric = z4c
expected_mode = sync

<parthenon/mesh>
refinement = none
nghost = 2
nx1 = 64
x1min = 0.0
x1max = 1.0
ix1_bc = periodic
ox1_bc = periodic
nx2 = 8
x2min = 0.0
x2max = 1.0
ix2_bc = periodic
ox2_bc = periodic
nx3 = 8
x3min = 0.0
x3max = 1.0
ix3_bc = periodic
ox3_bc = periodic

<parthenon/meshblock>
nx1 = 4
nx2 = 4
nx3 = 4

<parthenon/time>
integrator = rk2
tlim = 0.25
nlim = 100
ncycle_out_mesh = 20

<numerical_relativity>
cfl = 0.2
finite_difference_order = 2
dissipation = 0.0

<problem>
amplitude = 0.01

<parthenon/output1>
file_type = hdf5
dt = 0.0625
variables = nr.z4c,nr.adm,nr.constraints
id = nr4_uniform_reference
single_precision_output = false
ghost_zones = false
