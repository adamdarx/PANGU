# NR-4 quantitative Sommerfeld/outflow convergence problem.
# The wave is intentionally short enough that the comparison measures the
# physical boundary treatment before long-time nonlinear gauge effects dominate.

<parthenon/job>
problem_id = nr_linear_wave

<pangu>
strict_parameters = true
compatibility_mode = native

<geometry>
background = minkowski
expected_metric = z4c
expected_mode = sync

<parthenon/mesh>
refinement = none
nghost = 2
nx1 = 32
x1min = -0.5
x1max = 0.5
ix1_bc = outflow
ox1_bc = outflow
nx2 = 32
x2min = -0.5
x2max = 0.5
ix2_bc = outflow
ox2_bc = outflow
nx3 = 32
x3min = -0.5
x3max = 0.5
ix3_bc = outflow
ox3_bc = outflow

<parthenon/meshblock>
nx1 = 8
nx2 = 8
nx3 = 8

<parthenon/time>
integrator = rk2
tlim = 0.02
nlim = 100
ncycle_out_mesh = 1

<numerical_relativity>
cfl = 0.2
finite_difference_order = 2
dissipation = 0.0

<problem>
amplitude = 1.0e-6
kx1 = 1.0
kx2 = 1.0
kx3 = 0.0

<parthenon/output1>
file_type = hdf5
dt = 0.02
variables = nr.z4c,nr.adm,nr.constraints
id = nr4_outflow_linear
single_precision_output = false
ghost_zones = false
